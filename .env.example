# ── Embedding service ──────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://localhost:6756

# ── LLM Vision (OpenAI-compatible) ────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
FAST_MODEL=qwen2.5vl:32b
REASONING_MODEL=qwen2.5vl:72b
LLM_TIMEOUT=280
LLM_CONTEXT_WINDOW=64000
# Smart search: controls enable_thinking for the NL filter extraction call.
# Independent of LLM_THINKING (which controls the engine vision analysis).
# false = instruct mode (fast, ~4s); true = thinking mode (slower, ~20s).
LLM_SMARTSEARCH_THINKING=false
# Smart search: max_output_tokens for the /responses call.
# 512 is enough in instruct mode; increase to 4000+ if thinking is enabled.
SMART_SEARCH_MAX_TOKENS=512

# ── Frame sizes ────────────────────────────────────────────────────
FRAME_SIZE_EMBEDDER=224
FRAME_SIZE_LLM=768
FRAME_SAMPLE_COUNT=8

# ── Axis / VAPIX ───────────────────────────────────────────────────
AXIS_DEFAULT_USER=admin
AXIS_DEFAULT_PASS=changeme
AXIS_TEST_CAMERA_URL=http://192.168.1.101
AXIS_TEST_EVENT_ID=motion
AXIS_USERNAME=admin
AXIS_PASSWORD=changeme
AXIS_DOWNLOAD_FPS=4
AXIS_POLL_INTERVAL_SEC=10

# ── Storage ────────────────────────────────────────────────────────
CLIP_TEMP_DIR=/tmp/vsa_clips
CLIP_STORAGE_DIR=/data/vsa_storage
CLIP_TEMP_TTL_HOURS=24
LANCEDB_PATH=/data/vsa_lancedb

# ── Output ─────────────────────────────────────────────────────────
WEBHOOK_DEFAULT_URL=http://localhost:8000/api/internal/alert
INTERNAL_API_URL=http://localhost:8000

# ── Runtime engine ────────────────────────────────────────────────
QUEUE_MAX_WORKERS=4
QUEUE_MAX_DEPTH=100
LOG_LEVEL=INFO
DEBUG_MODE=false

# ── Frame debug (step-14) ─────────────────────────────────────────
# Se impostato, salva i crop grezzi (prima del resize) su disco per ispezione.
# Struttura: {FRAME_DEBUG_DIR}/{clip_id}/{zone_name}-{n:03d}.jpeg
# Lasciare vuoto per disabilitare.
FRAME_DEBUG_DIR=/data/frame

# ── Docker resource limits ─────────────────────────────────────────
DOCKER_API_CPU_LIMIT=1.0
DOCKER_API_MEM_LIMIT=512M
DOCKER_API_CPU_RES=0.25
DOCKER_API_MEM_RES=128M
DOCKER_ENGINE_CPU_LIMIT=2.0
DOCKER_ENGINE_MEM_LIMIT=2G
DOCKER_ENGINE_CPU_RES=0.5
DOCKER_ENGINE_MEM_RES=512M
DOCKER_FRONTEND_CPU_LIMIT=0.25
DOCKER_FRONTEND_MEM_LIMIT=128M
DOCKER_FRONTEND_CPU_RES=0.05
DOCKER_FRONTEND_MEM_RES=32M

# ── Startup lookback ───────────────────────────────────────────────
# All'avvio l'engine recupera le registrazioni delle ultime N ore.
# 0 o vuoto = usa solo il lookback normale (non recuperare storico).
AXIS_STARTUP_LOOKBACK_HOURS=2

# ── FFMPEG (download normalization) ────────────────────────────────
# Preset H.264 per la normalizzazione FPS dei clip Axis.
# ultrafast = minor CPU, qualità sufficiente per pipeline embedding.
# Valori validi: ultrafast | superfast | veryfast | faster | medium
FFMPEG_PRESET=ultrafast
# CRF: 0=lossless, 51=worst. 32 è ok per frame key; 23 è default ffmpeg.
FFMPEG_CRF=32
# Thread per processo ffmpeg. 1 evita il multi-core storm con molti worker.
FFMPEG_THREADS=1
# true  = ri-codifica ogni clip in H.264 prima dell'estrazione frame (legacy).
# false = salta la ri-codifica; OpenCV campiona direttamente dal file Axis.
#         Risparmio: ~100% del costo ffmpeg. Richiede test su VFR se la
#         telecamera esporta video a frame rate variabile.
FFMPEG_NORMALIZE=false

# ── API server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Multi-user auth (optional) ────────────────────────────────────
# API_USERNAME / API_PASSWORD define the admin account (default: admin/changeme).
# API_USER_USERNAME / API_USER_PASSWORD define an optional read-only user.
API_USER_USERNAME=user
API_USER_PASSWORD=userpass
