# ── Embedding service (remote — NOT the local embedder) ──────────────────────
EMBEDDING_BASE_URL=https://your-embedding-host/v1
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_API_KEY=

# ── LLM Vision ────────────────────────────────────────────────────────────────
LLM_BASE_URL=https://your-llm-host/v1
LLM_API_KEY=
FAST_MODEL=Galene/LLM
REASONING_MODEL=Galene/LLM
LLM_USEREASONING=true
LLM_TIMEOUT=600
LLM_CONTEXT_WINDOW=256000
EMB_CONTEXT_WINDOW=8000
LLM_THINKING=false

# ── Frame processing ──────────────────────────────────────────────────────────
FRAME_SIZE_EMBEDDER=224
FRAME_SIZE_LLM=768
EMBED_FPS=2
EMBED_WINDOW_SEC=4
EMBED_MAX_WINDOWS=5
EMBED_MIN_FRAME_DIFF=0.05
EMBED_TOP_K=1
LLM_MAX_CALLS=5
LLM_FRAME_SIZE_SEND=336
LLM_JPEG_QUALITY_SEND=80

# FRAME_DEBUG_DIR intentionally left empty — disables debug frame writing in production
FRAME_DEBUG_DIR=

# ── Axis cameras ──────────────────────────────────────────────────────────────
AXIS_USERNAME=
AXIS_PASSWORD=
AXIS_DOWNLOAD_FPS=4
AXIS_POLL_INTERVAL_SEC=10

# ── Storage (container-internal paths mapped via Docker volumes) ───────────────
CLIP_TEMP_DIR=/tmp/vsa_clips
CLIP_STORAGE_DIR=/data/clips
CLIP_TEMP_TTL_HOURS=24
LANCEDB_PATH=/data/lancedb

# ── Output ────────────────────────────────────────────────────────────────────
# Engine sends alerts to the API container on the internal Docker network
WEBHOOK_DEFAULT_URL=http://vsa-api:8000/api/internal/alert

# ── Runtime ───────────────────────────────────────────────────────────────────
QUEUE_MAX_WORKERS=4
QUEUE_MAX_DEPTH=100
LOG_LEVEL=INFO
DEBUG_MODE=false

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Auth ──────────────────────────────────────────────────────────────────────
API_USERNAME=admin
API_PASSWORD=change-me-in-production
JWT_SECRET=change-me-generate-with-python-secrets-token-urlsafe-32

# ── Config Management API ─────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONFIG_API_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS. Swagger UI works from the same nginx
# origin, so only add external tool origins here (Postman, separate dev hosts).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Host data path (used by docker-compose volumes bind mount) ────────────────
DATA_DIR=./data
